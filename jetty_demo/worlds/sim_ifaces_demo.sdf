<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="robot_conveyor_world">
    <physics name="fast" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Basic Scene Setup -->
    <scene>
      <ambient>0.1 0.2 0.2</ambient>
      <!-- <ambient>1 1 1</ambient> -->
      <background>0.0 0.048431 0.048431</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <gui>
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <camera_pose>-2.52 -1.12 1.9  0 0.579199 0.947343</camera_pose>

      </plugin>
    </gui>
    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.0 0.0 0.0 1</ambient>
            <diffuse>0.2 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include merge="true">
      <pose>0 -5 0  0 0 0</pose>
      <uri>sim_ifaces_demo.sdf</uri>
    </include>
  </world>
</sdf>



