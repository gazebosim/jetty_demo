    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <wheel_separation>0.6</wheel_separation>
      <wheel_radius>0.1651</wheel_radius>
      <odom_publish_frequency>1</odom_publish_frequency>
      <max_linear_acceleration>1</max_linear_acceleration>
      <min_linear_acceleration>-1</min_linear_acceleration>
      <max_angular_acceleration>2</max_angular_acceleration>
      <min_angular_acceleration>-2</min_angular_acceleration>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>1</max_angular_velocity>
      <min_angular_velocity>-1</min_angular_velocity>
    </plugin>

    <plugin
      filename="gz-sim-wheel-slip-system"
      name="gz::sim::systems::WheelSlip">
      <wheel link_name="front_right_wheel">
        <slip_compliance_lateral>0.001</slip_compliance_lateral>
        <slip_compliance_longitudinal>0.01</slip_compliance_longitudinal>
        <wheel_normal_force>1.5</wheel_normal_force>
        <wheel_radius>0.1651</wheel_radius>
      </wheel>
      <wheel link_name="front_left_wheel">
        <slip_compliance_lateral>0.001</slip_compliance_lateral>
        <slip_compliance_longitudinal>0.01</slip_compliance_longitudinal>
        <wheel_normal_force>1.5</wheel_normal_force>
        <wheel_radius>0.1651</wheel_radius>
      </wheel>
      <wheel link_name="rear_right_wheel">
        <slip_compliance_lateral>0.001</slip_compliance_lateral>
        <slip_compliance_longitudinal>0.01</slip_compliance_longitudinal>
        <wheel_normal_force>1</wheel_normal_force>
        <wheel_radius>0.1651</wheel_radius>
      </wheel>
      <wheel link_name="rear_left_wheel">
        <slip_compliance_lateral>0.001</slip_compliance_lateral>
        <slip_compliance_longitudinal>0.01</slip_compliance_longitudinal>
        <wheel_normal_force>1</wheel_normal_force>
        <wheel_radius>0.1651</wheel_radius>
      </wheel>
    </plugin>
    <plugin
      filename="gz-sim-lookup-wheel-slip-system"
      name="gz::sim::systems::LookupWheelSlip">
      <slip_map>warehouse_slip_map.png</slip_map>
      <size_x>61</size_x>
      <size_y>61</size_y>
      <slip_compliance_lateral_delta>0.05</slip_compliance_lateral_delta>
      <slip_compliance_longitudinal_delta>0.1</slip_compliance_longitudinal_delta>
      <friction_delta>0.5</friction_delta>
      <wheel_link_name>front_left_wheel</wheel_link_name>
      <wheel_link_name>front_right_wheel</wheel_link_name>
      <wheel_link_name>rear_left_wheel</wheel_link_name>
      <wheel_link_name>rear_right_wheel</wheel_link_name>
    </plugin>

  </model>
</sdf>
